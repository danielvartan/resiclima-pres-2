@software{wilensky1998,
  title = {Flocking model},
  author = {Wilensky, Uri},
  date = {1998},
  location = {Evanston, IL},
  url = {http://ccl.northwestern.edu/netlogo/models/Flocking},
  urldate = {2024-09-14},
  abstract = {This model is an attempt to mimic the flocking of birds. (The resulting motion also resembles schools of fish.) The flocks that appear in this model are not created or led in any way by special leader birds. Rather, each bird is following exactly the same set of rules, from which flocks emerge.},
